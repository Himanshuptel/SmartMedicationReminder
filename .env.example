# Smart Medication Reminder - Environment Variables Example
# Copy this file to .env and adjust variables as needed

# Server Port
PORT=5050

# Application Environment (development | production)
NODE_ENV=development

# Demo Mode (true enables 1-click presentation presets; false enforces strict production authentication)
DEMO_MODE=true

# Session / JWT Signing Secret (must be minimum 32 characters in production)
SESSION_SECRET=dev-insecure-secret-key-change-in-production-min32chars

# Allowed CORS Origins (comma separated)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Email / SMTP Configuration for 2FA OTP Delivery
# If left empty in development, OTP codes will be printed directly to the backend server console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@smartmedicationreminder.com
SMTP_SECURE=false

# Client API Base URL
VITE_API_URL=/api
